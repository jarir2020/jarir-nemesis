{
    "name": "swagger",
    "version": "1.0.0",
    "description": "Swagger plugin for Nemesis framework",
    "entry": "bootstrap.php",
    "requires": {
        "php": ">=8.0",
        "nemesis": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Nemesis\\Plugins\\Swagger\\": "src/"
        }
    },
    "permissions": [
        "routes",
        "middleware",
        "events"
    ]
}
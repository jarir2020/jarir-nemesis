{
    "name": "jarir/nemesis-framework",
    "description": "Nemesis: A High-Performance, Zero-Dependency PHP Framework for SaaS and APIs.",
    "version": "5.1.0",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "phpmailer/phpmailer": "^6.8",
        "league/flysystem": "^3.31",
        "league/flysystem-aws-s3-v3": "^3.31",
        "aws/aws-sdk-php": "^3.372.0",
        "zircote/swagger-php": "^6.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Nemesis\\": "src/",
            "Nemesis\\Contracts\\": "src/Contracts/",
            "Nemesis\\Exceptions\\": "src/Exceptions/",
            "Nemesis\\Attributes\\": "src/Attributes/",
            "App\\": "app/"
        },
        "files": [
            "src/Helpers/Helpers.php"
        ]
    },
    "authors": [
        {
            "name": "Jarir Ahmed",
            "email": "jarircse16@gmail.com"
        }
    ],
    "keywords": [
        "framework",
        "php",
        "zero-dependency",
        "orm",
        "mvc",
        "api"
    ],
    "homepage": "https://github.com/jarir2020/jarir-nemesis",
    "bin": ["bin/nemesis"],
    "minimum-stability": "stable",
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php bin/nemesis key:generate",
            "@php -r \"echo PHP_EOL . '✓ Nemesis project ready! Edit .env then run: php nemesis serve' . PHP_EOL;\""
        ]
    }
}
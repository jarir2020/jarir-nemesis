function writeJsonFile(string $path, mixed $data, bool $force = false): bool
{
    if (file_exists($path) && !$force) {
        return false;
    }

    ensureParentDirectory($path);
    $json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    file_put_contents($path, $json . PHP_EOL);
    return true;
}

function importBangladeshLocations(string $destination, string $source, bool $force = false): bool
{
    if (file_exists($destination) && !$force) {
        return false;
    }

    $raw = null;
    if (str_starts_with($source, 'http://') || str_starts_with($source, 'https://')) {
        $raw = @file_get_contents($source);
    } elseif (is_file($source)) {
        $raw = @file_get_contents($source);
    }

    if ($raw === false || $raw === null) {
        throw new \RuntimeException("Unable to import Bangladesh locations from [{$source}].");
    }

    $decoded = json_decode($raw, true);
    if (!is_array($decoded)) {
        throw new \RuntimeException("Bangladesh locations source did not contain valid JSON.");
    }

    ensureParentDirectory($destination);
    file_put_contents($destination, json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . PHP_EOL);
    return true;
}

function resolveFrontendFramework(?string $framework, bool $defaultToServer = true): string
{
    $framework = $framework === null ? '' : strtolower(trim($framework));

    if ($framework === '') {
        return $defaultToServer ? 'server' : '';
    }

    $manager = \Nemesis\Frontend\FrontendManager::getInstance();

    if (!$manager->supportsFramework($framework) && !$manager->isAllowed($framework)) {
        throw new \RuntimeException("Unsupported frontend framework [{$framework}].");
    }

    if (!$manager->isAllowed($framework)) {
        throw new \RuntimeException("Frontend framework [{$framework}] is not allowed.");
    }

    return $framework;
}

/**
 * @return array<int, string>
 */
function collectPhpFiles(string $root): array
{
    if (is_file($root)) {
        return str_ends_with($root, '.php') ? [$root] : [];
    }

    if (!is_dir($root)) {
        return [];
    }

    $files = [];
    $iterator = new \RecursiveIteratorIterator(
        new \RecursiveDirectoryIterator($root, \FilesystemIterator::SKIP_DOTS)
    );

    foreach ($iterator as $item) {
        if ($item->isFile() && str_ends_with($item->getFilename(), '.php')) {
            $path = $item->getPathname();
            if (str_contains($path, DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR)
                || str_contains($path, DIRECTORY_SEPARATOR . '.git' . DIRECTORY_SEPARATOR)
                || str_contains($path, DIRECTORY_SEPARATOR . 'storage' . DIRECTORY_SEPARATOR)) {
                continue;
            }

            $files[] = $path;
        }
    }

    sort($files);
    return $files;
}

function runPhpLint(string $path): array
{
    $cmd = escapeshellarg(PHP_BINARY) . ' -l ' . escapeshellarg($path) . ' 2>&1';
    $output = [];
    $code = 0;
    exec($cmd, $output, $code);

    return [$code, implode("\n", $output)];
}

// Command-line argument parsing
$command = $argv[1] ?? null;

switch ($command) {
    case 'make:controller':
        $name = $argv[2] ?? null;
        if (!$name) die("Usage: php nemesis make:controller Name\n");
        try {
            $scaffolder = new \Nemesis\Scaffolder\Scaffolder();
            $path = $scaffolder->generate('controller', $name);
            echo "Controller created at {$path}\n";
        } catch (\RuntimeException $e) {
            echo "Error: " . $e->getMessage() . "\n"; exit(1);
        }
        break;

    case 'make:model':
        $name = null;
        $connection = null;
        foreach ($argv as $index => $arg) {
            if ($index < 2) {
                continue;
            }

            if ($arg === '--help' || $arg === '-h') {
                echo "Usage: php nemesis make:model Name [--connection=name]\n";
                echo "  Creates an App\\Models\\* model stub.\n";
                echo "  Use --connection to pin the model to a named database connection.\n";
                echo "  Without --connection, the model uses the default database connection.\n";
                echo "  Use --list-connections to show available database connections.\n";
                break 2;
            }

            if ($arg === '--list-connections') {
                $payload = databaseConnectionsPayload();
                echo $payload['title'] . ":\n\n";
                foreach ($payload['connections'] as $item) {
                    echo "  {$item['name']}" . (!empty($item['default']) ? " (default)" : "") . "\n";
                    echo "    driver: {$item['driver']}\n";
                    echo "    target: {$item['target']}\n";
                }
                break 2;
            }

            if (str_starts_with($arg, '--connection=')) {
                $connection = substr($arg, 13);
                continue;
            }

            if ($name === null) {
                $name = $arg;
            }
        }
        if (!$name) die("Usage: php nemesis make:model Name [--connection=name]\n");
        try {
            $scaffolder = new \Nemesis\Scaffolder\Scaffolder();
            $tokens = [];
            if ($connection !== null && $connection !== '') {
                $tokens['ConnectionProperty'] = "    protected ?string \$connection = '" . str_replace("'", "\\'", strtolower(trim($connection))) . "';";
            }
            $path = $scaffolder->generate('model', $name, $tokens);
            echo "Model created at {$path}\n";
        } catch (\RuntimeException $e) {
            echo "Error: " . $e->getMessage() . "\n"; exit(1);
        }
        break;

    case 'db:list-connections':
        $json = in_array('--json', $argv, true);
        $pretty = in_array('--pretty', $argv, true);
        $brief = in_array('--brief', $argv, true);
        $payload = databaseConnectionsPayload();

        if ($json) {
            $flags = JSON_UNESCAPED_SLASHES;
            if ($pretty && !$brief) {
                $flags |= JSON_PRETTY_PRINT;
            }
            echo json_encode($payload, $flags) . "\n";
            break;
        }

        echo "Nemesis Database Connections:\n\n";
        if ($payload['connections'] === []) {
            echo "No database connections configured.\n";
            break;
        }

        foreach ($payload['connections'] as $item) {
            echo "  {$item['name']}" . (!empty($item['default']) ? " (default)" : "") . "\n";
            echo "    driver: {$item['driver']}\n";
            echo "    target: {$item['target']}\n";
            echo "    status: {$item['status']}\n";
        }
        break;

    case 'make:middleware':
        $name = $argv[2] ?? null;
        if (!$name) die("Usage: php nemesis make:middleware Name\n");
        // Fixed 2026-04-03: src/Middleware/ deleted — all middleware in app/Http/Middleware/
        try {
            $scaffolder = new \Nemesis\Scaffolder\Scaffolder();
            $path = $scaffolder->generate('middleware', $name);
            echo "Middleware created at {$path}\n";
        } catch (\RuntimeException $e) {
            echo "Error: " . $e->getMessage() . "\n"; exit(1);
        }
        break;

    case 'make:migration':
        $name = $argv[2] ?? null;
        if (!$name) die("Usage: php nemesis make:migration name\n");
        $timestamp = date('Y_m_d_His');
        $fileName = "{$timestamp}_{$name}.php";
        $path = $projectRoot . "/database/migrations/{$fileName}";
        $content = "<?php\n\nuse Nemesis\Database\Migration;\nuse Nemesis\Core\Database;\n\nclass {$name} extends Migration {\n    public function up() {\n        // Database::connect()->exec(\"CREATE TABLE ...\");\n    }\n\n    public function down() {\n        // Database::connect()->exec(\"DROP TABLE ...\");\n    }\n}\n";
        file_put_contents($path, $content);
        echo "Migration created at $path\n";
        break;

    case 'make:seeder':
        $name = $argv[2] ?? null;
        if (!$name) die("Usage: php nemesis make:seeder Name\n");
        $path = $projectRoot . "/database/seeders/{$name}.php";
        $content = "<?php\n\nuse Nemesis\Database\Seeder;\nuse Nemesis\Core\Database;\n\nclass {$name} extends Seeder {\n    public function run() {\n        // Database::connect()->exec(\"INSERT INTO ...\");\n    }\n}\n";
        file_put_contents($path, $content);
        echo "Seeder created at $path\n";
        break;

    case 'migrate:run':
        require_once $projectRoot . '/index.php'; // Bootstraps config and DB
        $manager = new \Nemesis\Database\MigrationManager($projectRoot . '/database/migrations');
        $manager->migrate();
        
        // Migrate Plugins
        $pluginManager = \Nemesis\Core\PluginManager::getInstance();
        $pluginManager->discover();
        foreach ($pluginManager->getActive() as $name => $plugin) {
            $path = $plugin['manifest']->getDirectory() . '/migrations';
            if (is_dir($path)) {
                echo "Running migrations for plugin: {$name}...\n";
                $manager = new \Nemesis\Database\MigrationManager($path);
                $manager->migrate();
            }
        }
        break;

    case 'migrate:rollback':
        require_once $projectRoot . '/index.php'; // Bootstraps config and DB
        $manager = new \Nemesis\Database\MigrationManager($projectRoot . '/database/migrations');
        $manager->rollback();
        break;

    case 'db:seed':
        require_once $projectRoot . '/index.php'; // Bootstraps config and DB
        $name = $argv[2] ?? null;
        $manager = new \Nemesis\Database\SeederManager($projectRoot . '/database/seeders');
        $manager->seed($name);
        break;

    case 'db:dump':
        require_once $projectRoot . '/index.php'; // Bootstraps config and DB
        $filename = $argv[2] ?? 'database_dump_' . date('Y_m_d_His') . '.sql';
        $dumper = new \Nemesis\Database\DatabaseDumper();
        if ($dumper->dump($filename)) {
            echo "Database dumped successfully to $filename\n";
        } else {
            echo "Failed to dump database.\n";
        }
        break;

    case 'db:truncate':
        require_once $projectRoot . '/index.php'; // Bootstraps config and DB
        $truncator = new \Nemesis\Database\DatabaseTruncator();
        if ($truncator->truncate()) {
            echo "All tables truncated successfully.\n";
        }
        break;

    case 'db:restore':
        require_once $projectRoot . '/index.php'; // Bootstraps config and DB
        $filename = $argv[2] ?? null;
        if (!$filename) die("Usage: php nemesis db:restore filename.sql\n");
        $restorer = new \Nemesis\Database\DatabaseRestorer();
        if ($restorer->restore($filename)) {
            echo "Database restored successfully from $filename\n";
        }
        break;

    case 'schedule:run':
        // Updated 2026-04-03: uses new Scheduler (replaces Schedule with global-$argv hack)
        require_once $projectRoot . '/index.php';
        $scheduler = new \Nemesis\Console\Scheduler();
        $kernel    = new \App\Console\Kernel();
        // Kernel::schedule() accepts both old Schedule and new Scheduler (same API)
        $kernel->schedule($scheduler);
        $scheduler->run();
        echo "Scheduled tasks complete.\n";
        break;

    case 'queue:work':
        require_once $projectRoot . '/index.php';
        echo "Queue worker started. Processing jobs...\n";
        
        while (true) {
            $jobRecord = \Nemesis\Queue\Queue::pop();
            
            if ($jobRecord) {
                try {
                    $job = unserialize($jobRecord['payload']);
                    echo "Processing: " . get_class($job) . "\n";
                    $job->handle();
                    echo "Processed: " . get_class($job) . "\n";
                    
                    $driverName = getenv('QUEUE_DRIVER') ?: 'sync';
                    if ($driverName === 'database') {
                        $driver = new \Nemesis\Queue\Drivers\DatabaseDriver();
                        $driver->delete($jobRecord['id']);
                    }
                } catch (\Exception $e) {
                    echo "Job failed: " . $e->getMessage() . "\n";
                }
            } else {
                usleep(1000000); // Wait 1 second if no job
            }
            
            // Allow maintenance mode check or graceful exit
            if (file_exists($projectRoot . '/storage/framework/down')) exit;
        }
        break;

    case 'make:job':
        $name = $argv[2] ?? null;
        if (!$name) die("Usage: php nemesis make:job Name\n");

            'TwoFactorController' => <<<'PHP'
<?php
declare(strict_types=1);
namespace App\Controllers\Auth;

use Nemesis\Auth\Totp;
use Nemesis\Auth\AuthManager;
use Nemesis\Http\Request;
use Nemesis\Http\Response;

class TwoFactorController
{
    public function setup(Request $request): Response
    {
        $user  = AuthManager::user($request);
        $totp  = new Totp(issuer: getenv('APP_NAME') ?: 'Nemesis', label: $user['email'] ?? '');
        return Response::json([
            'secret'      => $totp->getSecret(),
            'qr_uri'      => $totp->getProvisioningUri(),
        ]);
    }

    public function verify(Request $request): Response
    {
        $data = $request->validate(['secret' => 'required', 'code' => 'required']);
        $totp = new Totp($data['secret']);
        if (!$totp->verify($data['code'])) {
            return Response::json(['error' => 'Invalid TOTP code.'], 422);
        }
        return Response::json(['message' => '2FA verified successfully.']);
    }

    public function backupCodes(Request $request): Response
    {
        $user  = AuthManager::user($request);
        $codes = Totp::generateBackupCodes($user['id']);
        return Response::json(['backup_codes' => $codes, 'warning' => 'Store these safely. They will not be shown again.']);
    }
}

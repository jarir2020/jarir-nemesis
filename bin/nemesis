        break;

    case 'make:widget':
        $name = $argv[2] ?? null;
        if (!$name) die("Usage: php nemesis make:widget Name\n");
        try {
            $scaffolder = new \Nemesis\Scaffolder\Scaffolder();
            $paths = $scaffolder->generateWidget($name);
            foreach ($paths as $p) echo "Widget file created at {$p}\n";
        } catch (\RuntimeException $e) {
            echo "Error: " . $e->getMessage() . "\n"; exit(1);
        }
        break;

    case 'make:library':
        $name = $argv[2] ?? null;
        if (!$name) die("Usage: php nemesis make:library Name\n");

// Nemesis 6.0.0 | CLI entry — canonical file | Updated: 2026-04-04
// When invoked via bin/nemesis, $projectRoot is the project root (parent of bin/).
// When invoked directly from the project root, dirname(__FILE__) IS the project root.
$projectRoot = is_dir(dirname(__FILE__) . '/../vendor')
    ? dirname(dirname(__FILE__))   // running from bin/
    : dirname(__FILE__);           // running from project root
// Autoload dependencies
require_once $projectRoot . '/vendor/autoload.php';
$GLOBALS['projectRoot'] = $projectRoot;

define('NEMESIS_CONSOLE', true);

// Load configuration and environment
\Nemesis\Core\Config::load($projectRoot);
$apiFormatExampleLines = [
    'php nemesis api:format status --json --brief',
    'php nemesis api:format status --json --pretty',
    'php nemesis api:format status --json --source --brief',
    'php nemesis api:format status --json --source --pretty',
    'php nemesis api:format on',
    'php nemesis api:format off',
];

function loadExamplesCatalog(string $projectRoot): array
{
    $catalogPath = $projectRoot . '/examples/catalog.php';
    if (!file_exists($catalogPath)) {
        return [];
    }

    $catalog = require $catalogPath;
    return is_array($catalog) ? $catalog : [];
}

function loadFrontendCatalog(): \Nemesis\Frontend\FrontendManager
{
    return \Nemesis\Frontend\FrontendManager::getInstance();
}

function loadDatabaseCatalog(): array
{
    $database = \Nemesis\Core\Config::get('config.database', []);
    return is_array($database) ? $database : [];
}

function databaseConnectionsPayload(): array
{
    $database = loadDatabaseCatalog();
    $connections = $database['connections'] ?? [];
    $defaultName = (string) ($database['default_connection'] ?? 'default');

    $items = [];
    foreach ((array) $connections as $name => $config) {
        $name = (string) $name;
        $items[] = [
            'name' => $name,
            'default' => $name === $defaultName,
            'driver' => (string) ($config['driver'] ?? 'mysql'),
            'target' => (string) ($config['database'] ?? $config['dbname'] ?? 'n/a'),
            'status' => ((bool) ($config['enabled'] ?? true)) ? 'enabled' : 'disabled',
        ];
    }

    return [
        'title' => 'Nemesis Database Connections',
        'count' => count($items),
        'default' => $defaultName,
        'connections' => $items,
    ];
}

function docsRoots(): array
{
    $projectRoot = $GLOBALS['projectRoot'] ?? dirname(__FILE__);

    return [
        'docs' => rtrim((string) (getenv('NEMESIS_DOCS_ROOT') ?: ($projectRoot . '/docs')), '/'),
        'public_docs' => rtrim((string) (getenv('NEMESIS_PUBLIC_DOCS_ROOT') ?: ($projectRoot . '/public/docs')), '/'),
    ];
}

/**
 * @return array<string, array{path:string,mtime:int,size:int}>
 */
function collectSyncFiles(string $root): array
{
    if (!is_dir($root)) {
        return [];
    }

    $files = [];
    $iterator = new \RecursiveIteratorIterator(
        new \RecursiveDirectoryIterator($root, \FilesystemIterator::SKIP_DOTS)
    );

    foreach ($iterator as $item) {
        if (!$item->isFile()) {
            continue;
        }

        $relative = ltrim(str_replace('\\', '/', substr($item->getPathname(), strlen($root))), '/');
        $files[$relative] = [
            'path' => $item->getPathname(),
            'mtime' => (int) @filemtime($item->getPathname()),
            'size' => (int) @filesize($item->getPathname()),
        ];
    }

    ksort($files);
    return $files;
}

function ensureParentDirectory(string $path): void
{
    $dir = dirname($path);
    if (!is_dir($dir)) {
        mkdir($dir, 0755, true);
    }
}

function syncDocsTrees(string $docsRoot, string $publicDocsRoot, bool $dryRun = false): array
{
    $docsFiles = collectSyncFiles($docsRoot);
    $publicFiles = collectSyncFiles($publicDocsRoot);
    $allPaths = array_values(array_unique(array_merge(array_keys($docsFiles), array_keys($publicFiles))));
    sort($allPaths);

    $changes = [];
    foreach ($allPaths as $relative) {
        $docsFile = $docsFiles[$relative] ?? null;
        $publicFile = $publicFiles[$relative] ?? null;

        if ($docsFile === null && $publicFile === null) {
            continue;
        }

        if ($docsFile !== null && $publicFile === null) {
            $target = $publicDocsRoot . '/' . $relative;
            if (!$dryRun) {
                ensureParentDirectory($target);
                copy($docsFile['path'], $target);
            }
            $changes[] = [
                'path' => $relative,
                'direction' => 'docs->public/docs',
                'reason' => 'missing_in_public_docs',
            ];
            continue;
        }

        if ($docsFile === null && $publicFile !== null) {
            $target = $docsRoot . '/' . $relative;
            if (!$dryRun) {
                ensureParentDirectory($target);
                copy($publicFile['path'], $target);
            }
            $changes[] = [
                'path' => $relative,
                'direction' => 'public/docs->docs',
                'reason' => 'missing_in_docs',
            ];
            continue;
        }

        if ($docsFile['mtime'] > $publicFile['mtime']) {
            if (!$dryRun) {
                copy($docsFile['path'], $publicDocsRoot . '/' . $relative);
            }
            $changes[] = [
                'path' => $relative,
                'direction' => 'docs->public/docs',
                'reason' => 'docs_newer',
            ];
            continue;
        }

        if ($publicFile['mtime'] > $docsFile['mtime']) {
            if (!$dryRun) {
                copy($publicFile['path'], $docsRoot . '/' . $relative);
            }
            $changes[] = [
                'path' => $relative,
                'direction' => 'public/docs->docs',
                'reason' => 'public_docs_newer',
            ];
            continue;
        }

        if ($docsFile['mtime'] === $publicFile['mtime']) {
            $docsContent = @file_get_contents($docsFile['path']);
            $publicContent = @file_get_contents($publicFile['path']);
            if ($docsContent !== $publicContent) {
                if (!$dryRun) {
                    copy($docsFile['path'], $publicDocsRoot . '/' . $relative);
                }
                $changes[] = [
                    'path' => $relative,
                    'direction' => 'docs->public/docs',
                    'reason' => 'same_mtime_docs_wins',
                ];
            }
        }
    }

    return [
        'docs_root' => $docsRoot,
        'public_docs_root' => $publicDocsRoot,
        'count' => count($changes),
        'changes' => $changes,
        'in_sync' => $changes === [],
    ];
}

function dataRoot(): string
{
    $projectRoot = $GLOBALS['projectRoot'] ?? dirname(__FILE__);
    return rtrim((string) (getenv('NEMESIS_PUBLIC_DATA_ROOT') ?: ($projectRoot . '/public/data')), '/');
}

function ipRulesPath(): string
{
    $projectRoot = $GLOBALS['projectRoot'] ?? dirname(__FILE__);
    return rtrim((string) (getenv('NEMESIS_IP_RULES_PATH') ?: ($projectRoot . '/config/ip.php')), '/');
}

function loadIpRules(): array
{
    $path = ipRulesPath();
    if (!is_file($path)) {
        return [
            'allow_all' => true,
            'allow' => [],
            'block' => [],
            'trusted_proxies' => [],
        ];
    }

    $config = require $path;
    return is_array($config) ? $config : [];
}

function saveIpRules(array $config): void
{
    $path = ipRulesPath();
    ensureParentDirectory($path);
    $content = "<?php\n// Nemesis 7.1.0 | IP access rules | Updated: " . date('Y-m-d') . "\n\nreturn " . var_export($config, true) . ";\n";
    file_put_contents($path, $content);
}

function normalizeRuleList(array $rules): array
{
    $rules = array_map(static fn($rule) => strtolower(trim((string) $rule)), $rules);
    $rules = array_values(array_unique(array_filter($rules, static fn($rule) => $rule !== '')));
    sort($rules);
    return $rules;
}

function ipRulesPayload(array $config): array
{
    $policy = new \Nemesis\Support\IpAccess($config);
    $status = $policy->status();

    return [
        'title' => 'Nemesis IP Access Rules',
        'ip_rules_path' => ipRulesPath(),
        'allow_all' => (bool) ($status['allow_all'] ?? true),
        'allow_count' => count((array) ($status['allow'] ?? [])),
        'block_count' => count((array) ($status['block'] ?? [])),
        'trusted_proxy_count' => count((array) ($status['trusted_proxies'] ?? [])),
        'rules' => $status,
    ];
}

function defaultBangladeshSource(): string
{
    return (string) (getenv('NEMESIS_BANGLADESH_SOURCE') ?: 'https://raw.githubusercontent.com/jarir-in-atl/BangladeshLocations/refs/heads/main/bangladesh_locations.json');
}


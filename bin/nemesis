    case 'route:cache':
    case 'route:clear':
    case 'route:list':
    case 'route:export':
    case 'route:diagnose':
    case 'route': // Support "route cache" / "route clear"
        $routeArgs = array_slice($argv, 2);
        $routeOptions = [
            'method' => null,
            'framework' => null,
            'middleware' => null,
            'format' => 'json',
            'path' => null,
            'uri' => null,
            'host' => null,
            'json' => false,
            'json_pretty' => true,
        ];
        $routePositionals = [];
        $routeVerb = $routeArgs[0] ?? '';
        $routeAction = $routeArgs[1] ?? '';

        foreach ($routeArgs as $arg) {
            if (!is_string($arg)) {
                continue;
            }

            if (str_starts_with($arg, '--method=')) {
                $routeOptions['method'] = substr($arg, 9);
            } elseif (str_starts_with($arg, '--framework=')) {
                $routeOptions['framework'] = substr($arg, 12);
            } elseif (str_starts_with($arg, '--middleware=')) {
                $routeOptions['middleware'] = substr($arg, 13);
            } elseif (str_starts_with($arg, '--format=')) {
                $routeOptions['format'] = strtolower(substr($arg, 9));
            } elseif (str_starts_with($arg, '--host=')) {
                $routeOptions['host'] = substr($arg, 7);
            } elseif ($arg === '--json') {
                $routeOptions['json'] = true;
            } elseif ($arg === '--pretty') {
                $routeOptions['json_pretty'] = true;
            } elseif ($arg === '--brief') {
                $routeOptions['json_pretty'] = false;
            } elseif ($arg !== '' && $arg[0] !== '-') {
                if (!in_array($arg, ['cache', 'clear', 'list', 'export', 'diagnose'], true)) {
                    $routePositionals[] = $arg;
                }
            }
        }

        if (($command === 'route:clear') || ($routeVerb === 'clear') || ($routeVerb === 'cache' && $routeAction === 'clear')) {
            \Nemesis\Router\Router::clearCache();
            echo "Route cache cleared.\n";
        } elseif ($command === 'route:diagnose' || $routeVerb === 'diagnose') {
            require_once $projectRoot . '/vendor/autoload.php';
            \Nemesis\Core\Config::load($projectRoot);
            $router = require $projectRoot . '/routes/route.php';
            $uri = $routeOptions['uri'] ?? ($routePositionals[0] ?? null);
            $method = $routeOptions['method'] ?? ($routePositionals[1] ?? 'GET');

            if (!$uri || str_starts_with((string) $uri, '--')) {
                fwrite(STDERR, "Usage: php nemesis route:diagnose /uri [METHOD] [--host=example.com]\n");
                exit(1);
            }

            if (str_starts_with((string) $method, '--')) {
                $method = 'GET';
            }

            $report = $router->matchDiagnostics($uri, $method, $routeOptions['host']);
            if ($routeOptions['json']) {
                $jsonFlags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
                if ($routeOptions['json_pretty']) {
                    $jsonFlags |= JSON_PRETTY_PRINT;
                }
                echo json_encode($report, $jsonFlags) . PHP_EOL;
                break;
            }

            $output = new \Nemesis\Console\Output(false);
            $output->info('Route diagnostics');
            $output->line('Requested: ' . json_encode($report['requested'], JSON_UNESCAPED_SLASHES));
            $output->line('Matched: ' . ($report['matched'] ? 'yes' : 'no'));
            if (!empty($report['matched_route'])) {
                $output->line('Matched route: ' . json_encode($report['matched_route'], JSON_UNESCAPED_SLASHES));
            }
            if (!empty($report['fallback_route'])) {
                $output->line('Fallback route: ' . json_encode($report['fallback_route'], JSON_UNESCAPED_SLASHES));
            }
            $output->line('Checked routes: ' . count($report['checked_routes'] ?? []));
            $output->newLine();
            $rows = [];
            foreach (($report['checked_routes'] ?? []) as $candidate) {
                $rows[] = [
                    (string) ($candidate['index'] ?? ''),
                    (string) ($candidate['method'] ?? ''),
                    (string) ($candidate['uri'] ?? ''),
                    (string) ($candidate['name'] ?? ''),
                    (string) ($candidate['framework'] ?? ''),
                    !empty($candidate['matched']) ? 'yes' : 'no',
                    !empty($candidate['reasons']) ? implode(',', (array) $candidate['reasons']) : '',
                ];
            }
            $output->table(['#', 'Method', 'URI', 'Name', 'Framework', 'Match', 'Reasons'], $rows);
        } elseif ($command === 'route:list' || $routeVerb === 'list') {
            require_once $projectRoot . '/vendor/autoload.php';
            \Nemesis\Core\Config::load($projectRoot);
            $router = require $projectRoot . '/routes/route.php';
            $output = new \Nemesis\Console\Output(false);
            $filters = array_filter([
                'method' => $routeOptions['method'],
                'framework' => $routeOptions['framework'],
                'middleware' => $routeOptions['middleware'],
            ], static fn($value) => $value !== null && $value !== '');
            $diagnostics = $router->diagnostics($filters);
            $output->info('Route diagnostics');
            if (!empty($filters)) {
                $output->line('Filters: ' . json_encode($filters, JSON_UNESCAPED_SLASHES));
            }
            $output->line('Routes: ' . $diagnostics['route_count']);
            $output->line('Named routes: ' . $diagnostics['named_route_count']);
            $output->line('Cacheable routes: ' . $diagnostics['cacheable_route_count']);
            $output->line('Fallback route: ' . ($diagnostics['fallback_route'] ? 'yes' : 'no'));
            $output->newLine();
            $rows = [];
            foreach ($router->routeSummary($filters) as $route) {
                $rows[] = [
                    (string) $route['index'],
                    $route['method'],
                    $route['uri'],
                    (string) ($route['name'] ?? ''),
                    implode(',', (array) $route['middleware']),
                    $route['cacheable'] ? 'yes' : 'no',
                ];
            }
            $output->table(['#', 'Method', 'URI', 'Name', 'Middleware', 'Cache'], $rows);
        } elseif ($command === 'route:export' || $routeVerb === 'export') {
            require_once $projectRoot . '/vendor/autoload.php';
            \Nemesis\Core\Config::load($projectRoot);
            $router = require $projectRoot . '/routes/route.php';
            $filters = array_filter([
                'method' => $routeOptions['method'],
                'framework' => $routeOptions['framework'],
                'middleware' => $routeOptions['middleware'],
            ], static fn($value) => $value !== null && $value !== '');
            $file = $routeOptions['path'] ?: ($routePositionals[0] ?? null);
            if ($file === null) {
                $defaultExtension = in_array($routeOptions['format'], ['php', 'yaml'], true) ? $routeOptions['format'] : 'json';
                $file = $projectRoot . '/storage/framework/routes.' . $defaultExtension;
            }
            $path = $router->exportRoutes($file, $routeOptions['format'], $filters);
            echo "Routes exported to {$path}\n";
        } elseif (($command === 'route:cache' && $routeVerb === '') || ($routeVerb === 'cache' && $routeAction === '')) {
            require_once $projectRoot . '/vendor/autoload.php';
            \Nemesis\Core\Config::load($projectRoot);
            $router = require $projectRoot . '/routes/route.php';
            $router->warmCache();
            echo "Routes cached successfully.\n";
        }
        break;

    case 'api:format':
    case 'api:format:examples':
        require_once $projectRoot . '/vendor/autoload.php';
        \Nemesis\Core\Config::load($projectRoot);

        $args = array_slice($argv, 2);
        $jsonMode = in_array('--json', $args, true);
        $jsonPretty = true;
        $includeSource = false;
        $positionals = [];
        foreach ($args as $arg) {
            if ($arg === '--json') {
                continue;
            }

            if ($arg === '--pretty') {
                $jsonPretty = true;
                continue;
            }

            if ($arg === '--brief') {
                $jsonPretty = false;
                continue;
            }

            if ($arg === '--source') {
                $includeSource = true;
                continue;
            }

            if ($arg !== '' && $arg[0] !== '-') {
                $positionals[] = strtolower((string) $arg);
            }
        }

        $state = $positionals[0] ?? 'status';
            if (in_array($state, ['examples', 'example', 'matrix'], true) || $command === 'api:format:examples') {
            if ($jsonMode) {
                $jsonFlags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
                if ($jsonPretty) {
                    $jsonFlags |= JSON_PRETTY_PRINT;
                }
                echo json_encode([
                    'title' => 'API Format Examples',
                    'examples' => $apiFormatExampleLines,
                ], $jsonFlags) . PHP_EOL;
                break;
            }

            echo "API Format Examples:\n";
            foreach ($apiFormatExampleLines as $line) {
                echo '  ' . $line . "\n";
            }
            break;
        }

        if (!in_array($state, ['status', 'show', 'get', 'current', 'on', 'off', 'pretty', 'brief', 'true', 'false', '1', '0', 'yes', 'no'], true)) {
            fwrite(STDERR, "Usage: php nemesis api:format [status|on|off|pretty|brief|examples] [--json] [--pretty|--brief] [--source]\n");
            exit(1);
        }
        $pretty = match ($state) {
            'on', 'pretty', 'true', '1', 'yes' => true,
            'off', 'brief', 'false', '0', 'no' => false,
            default => null,
        };

        $configFile = $projectRoot . '/config/api.php';
        $current = (bool) \config('api.pretty_json', \config('app.json_pretty', true));
        $source = file_exists($configFile)
            ? 'config/api.php'
            : (getenv('APP_JSON_PRETTY') !== false ? 'env:APP_JSON_PRETTY' : 'config/app.php');

        if ($pretty === null) {
            if ($jsonMode) {
                $jsonFlags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
                if ($jsonPretty) {
                    $jsonFlags |= JSON_PRETTY_PRINT;
                }
                $payload = [
                    'mode' => $current ? 'pretty' : 'brief',
                    'pretty_json' => $current,
                ];
                if ($includeSource) {
                    $payload['source'] = $source;
                }
                echo json_encode($payload, $jsonFlags) . PHP_EOL;
            } else {
                echo 'API JSON format: ' . ($current ? 'pretty' : 'brief') . PHP_EOL;
            }
            break;
        }

        $content = "<?php\n// Nemesis 7.1.0 | API formatting defaults | Updated: " . date('Y-m-d') . "\n\nreturn [\n    'pretty_json' => " . ($pretty ? 'true' : 'false') . ",\n];\n";
        file_put_contents($configFile, $content);
        echo 'API JSON format set to ' . ($pretty ? 'pretty' : 'brief') . ".\n";
        break;

    case 'config:cache':
    case 'config':
    case 'configs': // Support "configs cache clear"
        if (($argv[2] ?? '') === 'cache' && ($argv[3] ?? '') === '') {
            require_once $projectRoot . '/index.php';
            \Nemesis\Core\Config::cache();
            echo "Configuration cached successfully.\n";
        } elseif (($argv[2] ?? '') === 'clear' || (($argv[2] ?? '') === 'cache' && ($argv[3] ?? '') === 'clear')) {
            \Nemesis\Core\Config::clear();
            echo "Configuration cache cleared.\n";
        }
        break;

    case 'view:clear':
    case 'views': // Support "views cache clear"
        if (($argv[2] ?? '') === 'clear' || (($argv[2] ?? '') === 'cache' && ($argv[3] ?? '') === 'clear')) {
            $dir = $projectRoot . '/storage/framework/views';
            if (is_dir($dir)) {
                $files = glob($dir . '/*');
                foreach ($files as $file) {
                    if (is_file($file)) unlink($file);
                }
            }
            echo "View cache cleared.\n";
        }
        break;

    case 'cache:clear':
    case 'all': // Support "all cache clear"
        if (($argv[2] ?? '') === 'clear' || (($argv[2] ?? '') === 'cache' && ($argv[3] ?? '') === 'clear')) {
            \Nemesis\Router\Router::clear();
            \Nemesis\Core\Config::clear();
            // Clear views too
            $dir = $projectRoot . '/storage/framework/views';
            if (is_dir($dir)) {
                $files = glob($dir . '/*');
                foreach ($files as $file) {
                    if (is_file($file)) unlink($file);
                }
            }
            echo "All framework caches cleared.\n";
        }
        break;

    case 'serve':
        $host = 'localhost';
        $port = 8000;
        $docRoot = $projectRoot . DIRECTORY_SEPARATOR . 'public';

        if (isset($argv[2])) {
            [$host, $port] = explode(':', $argv[2]);
        }

        echo "Starting development server on http://$host:$port\n";
        $docRoot = '"' . realpath($docRoot) . '"';
        exec("php -S $host:$port -t $docRoot");
        break;

    case 'down':
        $file = $projectRoot . '/storage/framework/down';
        if (!is_dir(dirname($file))) mkdir(dirname($file), 0755, true);
        file_put_contents($file, json_encode(['time' => date('Y-m-d H:i:s')]));
        echo "Application is now in maintenance mode.\n";
        break;

    case 'up':
        $file = $projectRoot . '/storage/framework/down';
        if (file_exists($file)) unlink($file);
        echo "Application is now live.\n";
        break;

    case 'debug:on':
        updateEnv('APP_DEBUG', 'true');
        echo "Application debug mode enabled.\n";
        break;

    case 'debug:off':
        updateEnv('APP_DEBUG', 'false');
        echo "Application debug mode disabled.\n";
        break;

    case 'storage:link':
        $target = $projectRoot . '/storage/app/public';
        $link = $projectRoot . '/public/storage';

        if (!is_dir($target)) {
            mkdir($target, 0755, true);
        }

        if (file_exists($link)) {
            echo "The \"public/storage\" directory already exists.\n";
            break;
        }

        if (PHP_OS_FAMILY === 'Windows') {
            // Windows symlink requires special permissions or developer mode
            // We'll try symlink() first, but provide a manual command if it fails
            if (@symlink($target, $link)) {
                echo "The [public/storage] link has been connected to [$target].\n";
            } else {
                echo "❌ Failed to create symlink using PHP. Windows may require Administrator privileges.\n";
                echo "🔧 Try running this manually in an ADMIN prompt:\n";
                echo "   mklink /D \"$link\" \"$target\"\n";
            }
        } else {
            if (symlink($target, $link)) {
                echo "The [public/storage] link has been connected to [$target].\n";
            } else {
                echo "❌ Failed to create symlink.\n";
            }
        }
        break;

    case 'websocket:serve':
        $port = $argv[2] ?? 8080;
        $server = new \Nemesis\Broadcasting\WebSocketServer('127.0.0.1', $port);
        $server->start();
        break;

    case 'key:generate':
        $key = bin2hex(random_bytes(16));
        updateEnv('APP_KEY', $key);
        echo "Application key generated: $key\n";
        break;

    case 'tinker':
        echo "Nemesis Tinker Shell (PHP " . PHP_VERSION . ")\n";
        echo "Type 'exit' to quit.\n\n";
        while (true) {
            $input = readline("nemesis> ");
            if ($input === 'exit') break;
            if (empty($input)) continue;
            
            readline_add_history($input);
            try {
                // Ensure context by using eval on the input
                // Wrap in print just in case
                if (!str_ends_with($input, ';')) $input .= ';';
                ob_start();
                eval($input);
                $out = ob_get_clean();
                if ($out) echo $out . "\n";
            } catch (\Throwable $e) {
                echo "Error: " . $e->getMessage() . "\n";
            }
        }
        break;

    case 'test':
        echo "Running Framework Test Suite...\n";
        passthru("php tests/RunAll.php");
        break;

    case 'list':
    case 'help':
        echo "Nemesis Framework Available Commands:\n\n";
        $cmds = [
            'serve' => 'Start the development server',
            'make:controller' => 'Create a new controller',
            'make:model' => 'Create a new model [--connection=name]',
            'make:middleware' => 'Create a new middleware',
            'make:migration' => 'Create a new database migration',
            'make:seeder' => 'Create a new database seeder',
            'make:job' => 'Create a new background job class',
            'make:policy' => 'Create a new authorization policy',
            'make:event'       => 'Create a new event class',
            'make:listener'    => 'Create a new event listener class',
            'make:trait'       => 'Create a new trait',
            'make:repository'  => 'Create a new repository class',
            'make:entity'      => 'Create a new entity class',
            'make:dto'         => 'Create a new DTO (readonly class)',
            'make:transformer' => 'Create a new transformer class',
            'make:manager'     => 'Create a new manager singleton',
            'make:handler'     => 'Create a new handler class',
            'make:interface'   => 'Create a new interface',
            'make:factory'     => 'Create a new factory class',
            'make:filter'      => 'Create a new query filter class',
            'make:widget'      => 'Create a new widget (folder + class + view)',
            'make:library'     => 'Create a new library class',
            'make:helper'      => 'Create a new helper file',
            'make:frontend'    => 'Create a starter bundle for a frontend framework [--framework=name]',
            'make:plugin'      => 'Create a new plugin scaffold (v2 manifest)',
            'make:module' => 'Create a new module structure',
            'make:resource' => 'Create a full resource stack (Model, Controller, Migration, etc.)',
            'make:auth' => 'Scaffold auth controllers (Login, Register, 2FA) + route hints',
            'make:social-auth' => 'Scaffold social OAuth controller for a given driver (e.g. make:social-auth google)',
            'schedule:run'      => 'Run all scheduled tasks that are due now (add to system cron: * * * * *)',
            'schedule:list'     => 'List all registered scheduled tasks with their cron expressions',
            'websocket:start'   => 'Start the WebSocket server [--host=127.0.0.1] [--port=6001]',
            'migrate:run' => 'Run all pending migrations',
            'migrate:rollback' => 'Rollback the last database migration',
            'db:seed' => 'Seed the database with records',
            'db:list-connections' => 'List configured database connections [--json] [--pretty|--brief]',
            'db:dump' => 'Export the database to a SQL file',
            'db:truncate' => 'Truncate all database tables',
            'db:restore' => 'Restore database from a SQL file',
            'cache:clear' => 'Flush the application cache',
            'route:cache' => 'Create a route cache file for faster routing',
            'route:clear' => 'Clear the route cache file',
            'route:list' => 'List registered routes and diagnostics',
            'route:export' => 'Export route diagnostics to JSON, PHP, or YAML',
            'route:diagnose' => 'Diagnose route matching for a URI and method [--json] [--pretty|--brief]',
            'api:format' => 'Show or set API JSON formatting defaults [status|on|off] [--json] [--pretty|--brief] [--source]',
            'api:format:examples' => 'Print the API JSON formatting matrix examples only',
            'config:cache' => 'Create a configuration cache file',
            'key:generate' => 'Set the APP_KEY in your .env file',
            'auth:rotate' => 'Rotate application secrets',
            'storage:link' => 'Link storage/app/public to public/storage',
            'model:health' => 'Scan models for DB issues and N+1 risks',
            'api:probe' => 'Proactive health check for all API routes',
            'env:doctor' => 'Sanity check for the application environment',
            'env' => 'Display the current application environment',
            'tinker' => 'Interact with your application in an REPL shell',
            'test' => 'Run the framework test suite',
            'deadcode:find' => 'Find unused code and routes',
            'app:mirror' => 'Start a read-only clone of the API',
            'api:docs' => 'Generate interactive API documentation HTML',
            'optimize' => 'Warm up all configuration and route caches',
            'down' => 'Put the application into maintenance mode',
            'up' => 'Bring the application out of maintenance mode',
            'plugin:list' => 'List all discovered plugins',
            'plugin:enable' => 'Enable a plugin',
            'plugin:disable' => 'Disable a plugin',
            'plugin:create' => 'Create a new plugin structure',
            'frontend:list' => 'List supported frontend frameworks and scaffold roots [--json] [--pretty|--brief]',
            'docs:sync' => 'Synchronize docs/ and public/docs/ [--dry-run] [--json] [--pretty|--brief]',
            'data:sync' => 'Scaffold public/data packs and import Bangladesh locations [--bangladesh-source=...] [--json] [--pretty|--brief]',
            'ip:list' => 'List IP allow/block rules [--json] [--pretty|--brief]',
            'ip:allow' => 'Allow an IP, CIDR, or wildcard pattern',
            'ip:block' => 'Block an IP, CIDR, or wildcard pattern',
            'ip:unallow' => 'Remove an IP rule from the allow list',
            'ip:unblock' => 'Remove an IP rule from the block list',
            'ip:reset' => 'Reset IP rules back to allow-all defaults',
            'syntax:check' => 'Lint PHP files with php -l [path|--all]',
            'examples:list' => 'Browse the optional starter gallery',
        ];
        foreach ($cmds as $c => $d) {
            echo "  " . str_pad($c, 20) . " $d\n";
        }
        echo "\nAPI Format Examples:\n";
        foreach ($apiFormatExampleLines as $line) {
            echo "  {$line}\n";
        }
        break;

    case 'plugin:list':
        echo "Nemesis Plugins:\n\n";
        $manager = \Nemesis\Core\PluginManager::getInstance();
        $manager->discover();
        $plugins = $manager->getAll();
        
        if (empty($plugins)) {
            echo "No plugins found.\n";
            break;
        }
        
        foreach ($plugins as $name => $plugin) {
            $manifest = $plugin['manifest'];
            $status = $manager->isActive($name) ? '✓ Active' : '✗ Disabled';
            echo "  {$name} v{$manifest->getVersion()} - {$status}\n";
            echo "    {$manifest->get('description', 'No description')}\n\n";
        }
        break;

    case 'plugin:enable':
        $name = $argv[2] ?? null;
        if (!$name) die("Usage: php nemesis plugin:enable {name}\n");
        
        $manager = \Nemesis\Core\PluginManager::getInstance();
        $manager->discover();
        
        try {
            $manager->enable($name);
            echo "Plugin '{$name}' enabled successfully.\n";
        } catch (\Exception $e) {
            echo "Error: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    case 'plugin:disable':
        $name = $argv[2] ?? null;
        if (!$name) die("Usage: php nemesis plugin:disable {name}\n");
        
        $manager = \Nemesis\Core\PluginManager::getInstance();
        $manager->disable($name);
        echo "Plugin '{$name}' disabled successfully.\n";
        break;

    case 'examples:list':
        $catalog = loadExamplesCatalog($projectRoot);
        if (empty($catalog)) {
            echo "No example gallery found.\n";
            break;
        }

        echo "Nemesis Examples Gallery:\n\n";
        $grouped = [];
        foreach ($catalog as $entry) {
            $grouped[$entry['category']][] = $entry;
        }

        ksort($grouped);
        foreach ($grouped as $category => $entries) {
            echo strtoupper($category) . " EXAMPLES\n";
            foreach ($entries as $entry) {
                echo "  {$entry['name']} - {$entry['title']}\n";
                echo "    {$entry['description']}\n";
                echo "    Path: {$entry['path']}\n";
            }
            echo "\n";
        }
        break;

    case 'docs:sync':
        $json = in_array('--json', $argv, true);
        $pretty = in_array('--pretty', $argv, true);
        $brief = in_array('--brief', $argv, true);
        $dryRun = in_array('--dry-run', $argv, true);
        $roots = docsRoots();
        $payload = syncDocsTrees($roots['docs'], $roots['public_docs'], $dryRun);
        $payload['dry_run'] = $dryRun;
        $payload['timestamp'] = date(DATE_ATOM);

        if ($json) {
            $flags = JSON_UNESCAPED_SLASHES;
            if ($pretty && !$brief) {
                $flags |= JSON_PRETTY_PRINT;
            }
            echo json_encode($payload, $flags) . "\n";
            break;
        }

        echo "Docs sync summary:\n";
        echo "  docs root:        {$payload['docs_root']}\n";
        echo "  public docs root:  {$payload['public_docs_root']}\n";
        echo "  changes:           {$payload['count']}\n";
        echo "  mode:              " . ($dryRun ? 'dry-run' : 'sync') . "\n";
        foreach ($payload['changes'] as $change) {
            echo "  - {$change['path']} ({$change['direction']}, {$change['reason']})\n";
        }
        if ($payload['in_sync']) {
            echo "  already in sync\n";
        }
        break;

    case 'data:sync':
        $json = in_array('--json', $argv, true);
        $pretty = in_array('--pretty', $argv, true);
        $brief = in_array('--brief', $argv, true);
        $force = in_array('--force', $argv, true);
        $bangladeshSource = defaultBangladeshSource();
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--bangladesh-source=')) {
                $bangladeshSource = substr($arg, 20);
            }
        }

        $root = dataRoot();
        $catalog = baseDataCatalog();
        $changes = [];

        foreach ($catalog as $file => $data) {
            $path = $root . '/' . $file;
            $written = writeJsonFile($path, $data, $force);
            if ($written) {
                $changes[] = [
                    'path' => $file,
                    'status' => 'written',
                ];
            } elseif (file_exists($path)) {
                $changes[] = [
                    'path' => $file,
                    'status' => 'skipped',
                ];
            }
        }

        $bangladeshPath = $root . '/bangladesh_locations.json';
        $bangladeshWritten = importBangladeshLocations($bangladeshPath, $bangladeshSource, $force);
        $changes[] = [
            'path' => 'bangladesh_locations.json',
            'status' => $bangladeshWritten ? 'imported' : 'skipped',
            'source' => $bangladeshSource,
        ];

        $payload = [
            'title' => 'Nemesis Public Data Packs',
            'count' => count($changes),
            'root' => $root,
            'changes' => $changes,
            'force' => $force,
            'bangladesh_source' => $bangladeshSource,
            'generated_at' => date(DATE_ATOM),
        ];

        if ($json) {
            $flags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
            if ($pretty && !$brief) {
                $flags |= JSON_PRETTY_PRINT;
            }
            echo json_encode($payload, $flags) . "\n";
            break;
        }

        echo "Nemesis Public Data Packs:\n\n";
        echo "  root: {$root}\n";
        foreach ($changes as $change) {
            $line = "  - {$change['path']} ({$change['status']})";
            if (!empty($change['source'])) {
                $line .= " source={$change['source']}";
            }
            echo $line . "\n";
        }
        break;

    case 'ip:list':
        $json = in_array('--json', $argv, true);
        $pretty = in_array('--pretty', $argv, true);
        $brief = in_array('--brief', $argv, true);
        $payload = ipRulesPayload(loadIpRules());

        if ($json) {
            $flags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
            if ($pretty && !$brief) {
                $flags |= JSON_PRETTY_PRINT;
            }
            echo json_encode($payload, $flags) . "\n";
            break;
        }

        echo "Nemesis IP Access Rules:\n\n";
        echo "  path: {$payload['ip_rules_path']}\n";
        echo "  allow all: " . ($payload['allow_all'] ? 'yes' : 'no') . "\n";
        echo "  allow count: {$payload['allow_count']}\n";
        echo "  block count: {$payload['block_count']}\n";
        echo "  trusted proxies: {$payload['trusted_proxy_count']}\n";
        echo "  current ip: " . ($payload['rules']['ip'] ?? 'n/a') . "\n";
        break;

    case 'ip:allow':
    case 'ip:block':
    case 'ip:unallow':
    case 'ip:unblock':
    case 'ip:reset':
        $json = in_array('--json', $argv, true);
        $pretty = in_array('--pretty', $argv, true);
        $brief = in_array('--brief', $argv, true);
        $rule = $argv[2] ?? null;
        $config = loadIpRules();
        $policy = new \Nemesis\Support\IpAccess($config);

        if ($command === 'ip:reset') {
            $policy = $policy->reset();
            saveIpRules($policy->getConfig());
            $payload = ipRulesPayload($policy->getConfig());
            if ($json) {
                $flags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
                if ($pretty && !$brief) {
                    $flags |= JSON_PRETTY_PRINT;
                }
                echo json_encode($payload, $flags) . "\n";
            } else {
                echo "IP rules reset to allow all.\n";
            }
            break;
        }

        if (!$rule) {
            $usage = match ($command) {
                'ip:allow' => "Usage: php nemesis ip:allow <ip|cidr|pattern>\n",
                'ip:block' => "Usage: php nemesis ip:block <ip|cidr|pattern>\n",
                'ip:unallow' => "Usage: php nemesis ip:unallow <ip|cidr|pattern>\n",
                'ip:unblock' => "Usage: php nemesis ip:unblock <ip|cidr|pattern>\n",
                default => "Usage: php nemesis {$command} <ip|cidr|pattern>\n",
            };
            die($usage);
        }

        if ($command === 'ip:allow') {
            $policy = $policy->withRule('allow', $rule);
        } elseif ($command === 'ip:block') {
            $policy = $policy->withRule('block', $rule);
        } elseif ($command === 'ip:unallow') {
            $policy = $policy->withoutRule('allow', $rule);
        } else {
            $policy = $policy->withoutRule('block', $rule);
        }

        saveIpRules($policy->getConfig());
        $payload = ipRulesPayload($policy->getConfig());
        if ($json) {
            $flags = JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE;
            if ($pretty && !$brief) {
                $flags |= JSON_PRETTY_PRINT;
            }
            echo json_encode($payload, $flags) . "\n";
        } else {
            echo "IP rules updated.\n";
        }
        break;

    case 'frontend:list':
        $manager = loadFrontendCatalog();
        $frameworks = $manager->supportedFrameworks();

        $json = in_array('--json', $argv, true);
        $pretty = in_array('--pretty', $argv, true);
        $brief = in_array('--brief', $argv, true);

        $payload = [
            'title' => 'Nemesis Frontend Frameworks',
            'count' => count($frameworks),
            'frameworks' => array_map(static function (string $framework) use ($manager): array {
                $config = $manager->frameworkConfig($framework);
                return [
                    'name' => $framework,
                    'allowed' => $manager->isAllowed($framework),
                    'enabled' => $manager->isEnabled($framework),
                    'compiler' => $config['compiler'] ?? null,
                    'views' => $config['views'] ?? null,
                    'entry' => $config['entry'] ?? null,
                    'build' => $config['build'] ?? null,
                    'manifest' => $config['manifest'] ?? null,
                    'middleware' => $config['middleware'] ?? null,
                    'fallback' => (bool) ($config['fallback'] ?? false),
                ];
            }, $frameworks),
        ];

        if ($json) {
            $flags = JSON_UNESCAPED_SLASHES;
            if (!$brief || $pretty) {
                $flags |= JSON_PRETTY_PRINT;
            }
            echo json_encode($payload, $flags) . "\n";
            break;
        }

        echo "Nemesis Frontend Frameworks:\n\n";
        foreach ($payload['frameworks'] as $item) {
            echo "  {$item['name']}\n";
            echo "    status:   " . ($item['allowed'] ? 'allowed' : 'blocked') . "\n";
            echo "    compiler: " . ($item['compiler'] ?? 'unknown') . "\n";
            echo "    views:    " . ($item['views'] ?? 'n/a') . "\n";
            echo "    entry:    " . ($item['entry'] ?? 'n/a') . "\n";
        }
        break;

    case 'plugin:create':
        $name = $argv[2] ?? null;
        if (!$name) die("Usage: php nemesis plugin:create {Name}\n");
        
        $pluginDir = $projectRoot . "/plugins/{$name}";
        if (is_dir($pluginDir)) die("Plugin [{$name}] already exists.\n");
        
        mkdir($pluginDir, 0755, true);
        mkdir("{$pluginDir}/src", 0755, true);
        mkdir("{$pluginDir}/config", 0755, true);
        mkdir("{$pluginDir}/migrations", 0755, true);
        
        // plugin.json
        $lowerName = strtolower($name);
        $manifest = [
            'name' => $lowerName,
            'version' => '1.0.0',
            'description' => "{$name} plugin for Nemesis framework",
            'entry' => 'bootstrap.php',
            'requires' => [
                'php' => '>=8.0',
                'nemesis' => '^1.0'
            ],
            'autoload' => [
                'psr-4' => [
                    "Nemesis\\Plugins\\{$name}\\" => 'src/'
                ]
            ],
            'permissions' => ['routes', 'middleware', 'events']
        ];
        file_put_contents("{$pluginDir}/plugin.json", json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
        
        // bootstrap.php
        $bootstrap = "<?php\n\nuse Nemesis\\Core\\Plugin;\n\nPlugin::register('{$lowerName}', function(\$plugin) {\n    // Register routes\n    \$plugin->route('{$lowerName}', function() {\n        // Add your routes here\n    });\n    \n    // Register middleware\n    // \$plugin->middleware(YourMiddleware::class);\n    \n    // Register hooks\n    // Plugin::hook('app.boot', function() {\n    //     // Your hook logic\n    // });\n});\n";
        file_put_contents("{$pluginDir}/bootstrap.php", $bootstrap);
        
        // README.md
        $readme = "# {$name} Plugin\n\n{$manifest['description']}\n\n## Installation\n\n```bash\nphp nemesis plugin:enable {$lowerName}\n```\n\n## Usage\n\nAdd your usage instructions here.\n";
        file_put_contents("{$pluginDir}/README.md", $readme);
        
        echo "Plugin [{$name}] created successfully at {$pluginDir}\n";
        echo "Enable it with: php nemesis plugin:enable {$lowerName}\n";
        break;

    case 'env':
        echo "Current Application Environment:\n";
        echo "  APP_ENV:    " . (getenv('APP_ENV') ?: 'production') . "\n";
        echo "  APP_DEBUG:  " . (getenv('APP_DEBUG') ?: 'false') . "\n";
        echo "  APP_URL:    " . (getenv('APP_URL') ?: 'http://localhost') . "\n";
        echo "  Config:     " . ($projectRoot . '/config/config.php') . "\n";
        echo "  Platform:   " . PHP_OS_FAMILY . " (" . PHP_VERSION . ")\n";
        break;

    // =========================================================================
    // Phase 10: Frontend / Asset Pipeline commands | Added: 2026-04-03
    // =========================================================================

    case 'vite:init':
        // Scaffold Vite config + package.json into project root
        $overwrite = in_array('--force', $argv, true);

        $files = [
            $projectRoot . '/vite.config.js'  => $projectRoot . '/src/Scaffolder/stubs/vite.config.stub',
            $projectRoot . '/package.json'    => $projectRoot . '/src/Scaffolder/stubs/package.vite.stub',
        ];

        foreach ($files as $dest => $stub) {
            $base = basename($dest);
            if (file_exists($dest) && !$overwrite) {
                echo "  [skip] {$base} already exists (use --force to overwrite)\n";
                continue;
            }
            copy($stub, $dest);
            echo "  [ok]   {$base} created\n";
        }

        // Ensure resources/ structure exists
        foreach (['resources/js', 'resources/css', 'resources/images', 'storage/framework'] as $dir) {
            if (!is_dir($projectRoot . '/' . $dir)) {
                mkdir($projectRoot . '/' . $dir, 0755, true);
            }
        }

        // Create resource entry points if missing
        if (!file_exists($projectRoot . '/resources/js/app.js')) {
            copy($projectRoot . '/src/Scaffolder/stubs/vite.config.stub', $projectRoot . '/resources/js/app.js');
        }

        // Write .env additions
        $envFile = $projectRoot . '/.env';
        if (file_exists($envFile)) {
            $env = file_get_contents($envFile);
            if (!str_contains($env, 'ASSET_DRIVER')) {
                file_put_contents($envFile, $env . "\nASSET_DRIVER=vite\nVITE_DEV_URL=http://localhost:5173\n");
                echo "  [ok]   .env updated with ASSET_DRIVER and VITE_DEV_URL\n";
            }
        }

        echo "\nVite scaffolding complete!\n";
        echo "Next steps:\n";
        echo "  1.  npm install\n";
        echo "  2.  npm run dev   (starts HMR dev server on :5173)\n";
        echo "  3.  npm run build (production build to public/build/)\n";
        echo "\nIn your layout template add:  <?= vite('resources/js/app.js') ?>\n";
        break;

    case 'webpack:init':
        $overwrite = in_array('--force', $argv, true);

        $files = [
            $projectRoot . '/webpack.config.js' => $projectRoot . '/src/Scaffolder/stubs/webpack.config.stub',
            $projectRoot . '/package.json'      => $projectRoot . '/src/Scaffolder/stubs/package.webpack.stub',
        ];

        foreach ($files as $dest => $stub) {
            $base = basename($dest);
            if (file_exists($dest) && !$overwrite) {
                echo "  [skip] {$base} already exists (use --force to overwrite)\n";
                continue;
            }
            copy($stub, $dest);
            echo "  [ok]   {$base} created\n";
        }

        foreach (['resources/js', 'resources/css', 'resources/images'] as $dir) {
            if (!is_dir($projectRoot . '/' . $dir)) {
                mkdir($projectRoot . '/' . $dir, 0755, true);
            }
        }

        $envFile = $projectRoot . '/.env';
        if (file_exists($envFile)) {
            $env = file_get_contents($envFile);
            if (!str_contains($env, 'ASSET_DRIVER')) {
                file_put_contents($envFile, $env . "\nASSET_DRIVER=webpack\nMIX_DEV_URL=http://localhost:8080\n");
                echo "  [ok]   .env updated with ASSET_DRIVER\n";
            }
        }

        echo "\nWebpack scaffolding complete!\n";
        echo "Next steps:\n";
        echo "  1.  npm install\n";
        echo "  2.  npm run dev   (watch mode)\n";
        echo "  3.  npm run build (production build to public/build/)\n";
        echo "\nIn your template add:  <?= mix('/js/app.js') ?>\n";
        break;

    case 'asset:publish':
        // Copy plugin/module asset directories into public/
        $publicDir = $projectRoot . '/public';
        $published  = 0;

        // Scan plugins for an 'assets/' subdirectory
        $pluginsDir = $projectRoot . '/plugins';
        if (is_dir($pluginsDir)) {
            foreach (scandir($pluginsDir) as $plugin) {
                if ($plugin[0] === '.') continue;
                $assetSrc = "{$pluginsDir}/{$plugin}/assets";
                if (!is_dir($assetSrc)) continue;

                $assetDest = "{$publicDir}/vendor/{$plugin}";
                if (!is_dir($assetDest)) mkdir($assetDest, 0755, true);

                $iter = new \RecursiveIteratorIterator(
                    new \RecursiveDirectoryIterator($assetSrc, \FilesystemIterator::SKIP_DOTS)
                );
                foreach ($iter as $file) {
                    if (!$file->isFile()) continue;
                    $rel  = substr($file->getPathname(), strlen($assetSrc) + 1);
                    $dest = $assetDest . '/' . $rel;
                    if (!is_dir(dirname($dest))) mkdir(dirname($dest), 0755, true);
                    copy($file->getPathname(), $dest);
                    $published++;
                }
                echo "  [ok] {$plugin} → public/vendor/{$plugin}\n";
            }
        }

        echo "asset:publish complete. {$published} file(s) copied.\n";
        break;

    case 'frontend:install':
        // Install a named frontend stack scaffold
        $stack = $argv[2] ?? null;
        $stacks = [
            'alpine'    => 'Alpine.js — lightweight reactivity, no build step needed',
            'angular'   => 'Angular — enterprise SPA framework',
            'astro'     => 'Astro — content-focused web framework',
            'ember'     => 'Ember — convention-heavy front-end framework',
            'ghost'     => 'Ghost.js — owner\'s custom JS framework',
            'htmx'      => 'htmx — hypermedia-driven interactions',
            'inertia'   => 'Inertia.js — SPA adapter (Vue/React) without a full API',
            'jquery'    => 'jQuery — universal DOM/AJAX library',
            'lit'       => 'Lit — lightweight web components',
            'livewire'  => 'Livewire — reactive PHP UI components',
            'next'      => 'Next.js — React framework with routing and SSR',
            'nuxt'      => 'Nuxt — Vue meta-framework with SSR and routing',
            'preact'    => 'Preact — tiny React-compatible UI library',
            'qwik'      => 'Qwik — resumable frontend framework',
            'react'     => 'React — component-driven UI library',
            'remix'     => 'Remix — React framework for nested routing',
            'solid'     => 'SolidJS — fine-grained reactive UI framework',
            'svelte'    => 'Svelte — compiler-first UI framework',
            'sveltekit' => 'SvelteKit — app framework for Svelte',
            'vue'       => 'Vue — progressive UI framework',
        ];

        if (!$stack || !isset($stacks[$stack])) {
            echo "Usage: php nemesis frontend:install {stack}\n\n";
            echo "Available stacks:\n";
            foreach ($stacks as $name => $desc) {
                echo "  {$name}  — {$desc}\n";
            }
            break;
        }

        // npm package names per stack
        $packages = [
            'alpine'    => ['alpinejs'],
            'angular'   => ['@angular/core', '@angular/cli'],
            'astro'     => ['astro'],
            'ember'     => ['ember-source'],
            'ghost'     => [],   // local — remind user to link manually
            'htmx'      => ['htmx.org'],
            'inertia'   => ['@inertiajs/core', '@inertiajs/vue3'],
            'jquery'    => ['jquery'],
            'lit'       => ['lit'],
            'livewire'  => ['livewire'],
            'next'      => ['next', 'react', 'react-dom'],
            'nuxt'      => ['nuxt'],
            'preact'    => ['preact'],
            'qwik'      => ['@builder.io/qwik'],
            'react'     => ['react', 'react-dom'],
            'remix'     => ['@remix-run/react', '@remix-run/node'],
            'solid'     => ['solid-js'],
            'svelte'    => ['svelte'],
            'sveltekit' => ['@sveltejs/kit', 'svelte'],
            'vue'       => ['vue'],
        ];

        if ($stack === 'ghost') {
            echo "Ghost.js is a local framework at D:\\Project Ghost.js\n";
            echo "To link it, run:\n";
            echo "  cd D:\\Project Ghost.js && npm link\n";
            echo "  cd D:\\Project Nemesis  && npm link ghost.js\n";
            echo "Then import it in resources/js/app.js:\n";
            echo "  import Ghost from 'ghost.js';\n";
            break;
        }

        $pkgs = implode(' ', $packages[$stack] ?? []);
        if ($pkgs) {
            echo "Installing {$stack}: npm install {$pkgs}\n";
            passthru("npm install {$pkgs}");
        }

        // Write a bootstrap snippet into resources/js/
        $bootstrapFile = $projectRoot . "/resources/js/bootstrap-{$stack}.js";
        $snippets = [
            'alpine' => "import Alpine from 'alpinejs';\nwindow.Alpine = Alpine;\nAlpine.start();\n",
            'inertia' => "import { createApp, h } from 'vue';\nimport { createInertiaApp } from '@inertiajs/vue3';\ncreateInertiaApp({\n    resolve: name => import(`./Pages/\${name}.vue`),\n    setup({ el, App, props, plugin }) {\n        createApp({ render: () => h(App, props) }).use(plugin).mount(el);\n    },\n});\n",
            'jquery'  => "import $ from 'jquery';\nwindow.$ = window.jQuery = $;\n",
        ];
        $bootstrap = $snippets[$stack] ?? "// {$stack} bootstrap placeholder\n// Add framework-specific setup here.\n";
        file_put_contents($bootstrapFile, $bootstrap);
        echo "  [ok]   resources/js/bootstrap-{$stack}.js created\n";
        echo "  Add to your app.js:  import './bootstrap-{$stack}';\n";

        echo "\n{$stack} installed. Run `npm run dev` to start.\n";
        break;

    case 'make:frontend':
        $name = null;
        $framework = null;
        $manager = loadFrontendCatalog();

        if (in_array('--help', $argv, true) || in_array('-h', $argv, true)) {
            echo "Usage: php nemesis make:frontend <name> [--framework=name]\n";
            echo "Create a beginner-friendly starter bundle for a frontend framework.\n\n";
            echo "Examples:\n";
            echo "  php nemesis make:frontend landing --framework=astro\n";
            echo "  php nemesis make:frontend dashboard vue\n";
            echo "  php nemesis frontend:list --json\n";
            echo "\nUse php nemesis frontend:list to inspect supported framework names.\n";
            break;
        }

        foreach ($argv as $index => $arg) {
            if ($index < 2) {
                continue;
            }

            if (str_starts_with($arg, '--framework=')) {
                $framework = substr($arg, 12);
                continue;
            }

            if ($arg === '--force') {
                continue;
            }

            if ($framework === null && $name === null && $manager->supportsFramework($arg)) {
                $framework = $arg;
                continue;
            }

            if ($name === null) {
                $name = $arg;
            }
        }

        $name = $name ?? 'starter';
        $framework = resolveFrontendFramework($framework ?? 'server');

        try {
            $scaffolder = new \Nemesis\Scaffolder\Scaffolder();
            $paths = $scaffolder->generateFrontendStarter($framework, $name);
            echo "Frontend starter scaffold created for {$framework}:\n";
            foreach ($paths as $path) {
                echo "  {$path}\n";
            }
        } catch (\RuntimeException $e) {
            echo "Error: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    case 'syntax:check':
        $target = null;
        $all = in_array('--all', $argv, true);
        foreach ($argv as $index => $arg) {
            if ($index < 2) {
                continue;
            }
            if ($arg === '--all') {
                continue;
            }
            if ($target === null) {
                $target = $arg;
            }
        }

        $paths = $all
            ? collectPhpFiles($projectRoot)
            : collectPhpFiles($target ?? $projectRoot);

        if (empty($paths)) {
            echo "No PHP files found to check.\n";
            break;
        }

        $failures = 0;
        foreach ($paths as $path) {
            [$code, $output] = runPhpLint($path);
            if ($code === 0) {
                echo "OK   {$path}\n";
                continue;
            }

            $failures++;
            echo "FAIL {$path}\n";
            echo $output . "\n";
        }

        echo "\nSyntax check complete: " . (count($paths) - $failures) . " passed, {$failures} failed.\n";
        if ($failures > 0) {
            exit(1);
        }
        break;

    // Phase 9: vendor:shrink — strips dev-only files from the vendor directory | 2026-04-03
    case 'vendor:shrink':
        $vendorDir = $projectRoot . '/vendor';
        if (!is_dir($vendorDir)) {
            echo "vendor/ directory not found. Run 'composer install' first.\n";
            break;
        }

        // Patterns to remove (docs, tests, CI configs)
        $removePatterns = [
            'test', 'tests', 'Test', 'Tests',
            'spec', 'specs', 'Spec', 'Specs',
            'docs', 'doc', 'documentation', 'Documentation',
            'examples', 'example', 'Example', 'Examples',
            'demo', 'demos',
            '.github', '.travis.yml', '.scrutinizer.yml',
            'phpunit.xml', 'phpunit.xml.dist',
            'phpcs.xml', 'phpcs.xml.dist',
            '.editorconfig', '.gitattributes', '.gitignore',
            'CHANGELOG.md', 'CHANGELOG', 'CHANGES.md',
            'UPGRADE.md', 'UPGRADING.md',
            'Makefile', 'Dockerfile',
        ];

        $removed = 0;
        $bytes   = 0;

        $iter = new \RecursiveIteratorIterator(
            new \RecursiveDirectoryIterator($vendorDir, \FilesystemIterator::SKIP_DOTS),
            \RecursiveIteratorIterator::CHILD_FIRST
        );

        foreach ($iter as $file) {
            $basename = $file->getBasename();
            if (!in_array($basename, $removePatterns, true)) continue;

            if ($file->isDir()) {
                // Count directory size before removal
                $dirIter = new \RecursiveIteratorIterator(
                    new \RecursiveDirectoryIterator($file->getPathname(), \FilesystemIterator::SKIP_DOTS)
                );
                foreach ($dirIter as $f) {
                    if ($f->isFile()) $bytes += $f->getSize();
                }
                // Remove directory recursively
                $dirFiles = new \RecursiveIteratorIterator(
                    new \RecursiveDirectoryIterator($file->getPathname(), \FilesystemIterator::SKIP_DOTS),
                    \RecursiveIteratorIterator::CHILD_FIRST
                );
                foreach ($dirFiles as $df) {
                    $df->isDir() ? rmdir($df->getPathname()) : unlink($df->getPathname());
                }
                @rmdir($file->getPathname());
                $removed++;
            } elseif ($file->isFile()) {
                $bytes += $file->getSize();
                unlink($file->getPathname());
                $removed++;
            }
        }

        $kb = round($bytes / 1024, 1);
        echo "vendor:shrink complete. Removed {$removed} entries, freed ~{$kb} KB.\n";
        echo "WARNING: Run 'composer dump-autoload' if autoloading breaks.\n";
        break;

    // Phase 21: tenant:create — provision a new tenant | 2026-04-06
    case 'tenant:create':
        $tenantName   = $argv[2] ?? null;
        $tenantDomain = $argv[3] ?? '';
        $tenantSlug   = $argv[4] ?? '';

        if (!$tenantName) {
            die("Usage: php nemesis tenant:create \"Tenant Name\" [domain] [slug]\n");
        }

        try {
            $tenant = \Nemesis\Tenancy\TenantManager::create([
                'name'   => $tenantName,
                'domain' => $tenantDomain,
                'slug'   => $tenantSlug ?: \Nemesis\Tenancy\TenantManager::slugify($tenantName),
            ]);
            echo "Tenant created:\n";
            echo "  ID:     {$tenant->id}\n";
            echo "  Name:   {$tenant->name}\n";
            echo "  Slug:   {$tenant->slug}\n";
            echo "  Domain: " . ($tenant->domain ?: '(none)') . "\n";
            echo "  Active: " . ($tenant->active ? 'yes' : 'no') . "\n";
        } catch (\Throwable $e) {
            echo "Error: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    // Phase 21: tenant:list — display all tenants | 2026-04-06
    case 'tenant:list':
        try {
            $tenants = \Nemesis\Tenancy\TenantManager::all();
            if (empty($tenants)) {
                echo "No tenants found.\n";
                break;
            }
            printf("%-5s %-20s %-20s %-30s %-6s\n", 'ID', 'Name', 'Slug', 'Domain', 'Active');
            echo str_repeat('-', 85) . "\n";
            foreach ($tenants as $t) {
                printf(
                    "%-5s %-20s %-20s %-30s %-6s\n",
                    $t->id,
                    mb_strimwidth($t->name, 0, 19, '…'),
                    mb_strimwidth($t->slug, 0, 19, '…'),
                    mb_strimwidth($t->domain ?: '—', 0, 29, '…'),
                    $t->active ? 'yes' : 'no'
                );
            }
            echo "\nTotal: " . count($tenants) . " tenant(s)\n";
        } catch (\Throwable $e) {
            echo "Error: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    // Phase 21: tenant:activate / tenant:deactivate | 2026-04-06
    case 'tenant:activate':
    case 'tenant:deactivate':
        $tenantId = isset($argv[2]) ? (int) $argv[2] : 0;
        if (!$tenantId) die("Usage: php nemesis {$command} {id}\n");

        try {
            if ($command === 'tenant:activate') {
                \Nemesis\Tenancy\TenantManager::activate($tenantId);
                echo "Tenant #{$tenantId} activated.\n";
            } else {
                \Nemesis\Tenancy\TenantManager::deactivate($tenantId);
                echo "Tenant #{$tenantId} deactivated.\n";
            }
        } catch (\Throwable $e) {
            echo "Error: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    // Phase 21: tenant:delete — remove a tenant record | 2026-04-06
    case 'tenant:delete':
        $tenantId = isset($argv[2]) ? (int) $argv[2] : 0;
        if (!$tenantId) die("Usage: php nemesis tenant:delete {id}\n");

        echo "Are you sure you want to delete tenant #{$tenantId}? [y/N] ";
        $confirm = strtolower(trim((string) fgets(STDIN)));
        if ($confirm !== 'y') {
            echo "Aborted.\n";
            break;
        }

        try {
            \Nemesis\Tenancy\TenantManager::delete($tenantId);
            echo "Tenant #{$tenantId} deleted.\n";
        } catch (\Throwable $e) {
            echo "Error: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    // Phase 21: tenant:migrate — run migrations scoped to a tenant (DB-per-tenant) | 2026-04-06
    case 'tenant:migrate':
        $tenantSlug = $argv[2] ?? null;

        try {
            $tenants = $tenantSlug
                ? array_filter(
                    \Nemesis\Tenancy\TenantManager::all(),
                    fn($t) => $t->slug === $tenantSlug
                )
                : \Nemesis\Tenancy\TenantManager::all();

            if (empty($tenants)) {
                echo $tenantSlug ? "Tenant '{$tenantSlug}' not found.\n" : "No tenants found.\n";
                break;
            }

            foreach ($tenants as $tenant) {
                echo "Migrating tenant: {$tenant->name} ({$tenant->slug})...\n";

                // For DB-per-tenant strategy, switch connection first.
                $strategy = getenv('TENANCY_STRATEGY') ?: 'shared_database';
                if ($strategy === 'database_per_tenant') {
                    \Nemesis\Tenancy\TenantManager::switchConnection($tenant);
                } else {
                    \Nemesis\Tenancy\TenantManager::setCurrent($tenant);
                }

                // Run the app's migration runner if available.
                $migratorClass = '\Nemesis\Database\Migrator';
                if (class_exists($migratorClass)) {
                    $migrator = new $migratorClass(\Nemesis\Core\Database::getPdo());
                    $migrator->run($projectRoot . '/database/migrations');
                    echo "  [ok] Migrations applied for {$tenant->slug}.\n";
                } else {
                    echo "  [skip] No Migrator class found — implement Nemesis\\Database\\Migrator.\n";
                }
            }
        } catch (\Throwable $e) {
            echo "Error: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    // Phase 21: tenant:seed — run seeders for tenant(s) | 2026-04-06
    case 'tenant:seed':
        $tenantSlug  = $argv[2] ?? null;
        $seederClass = $argv[3] ?? 'DatabaseSeeder';

        try {
            $tenants = $tenantSlug
                ? array_filter(
                    \Nemesis\Tenancy\TenantManager::all(),
                    fn($t) => $t->slug === $tenantSlug
                )
                : \Nemesis\Tenancy\TenantManager::all();

            if (empty($tenants)) {
                echo $tenantSlug ? "Tenant '{$tenantSlug}' not found.\n" : "No tenants found.\n";
                break;
            }

            foreach ($tenants as $tenant) {
                echo "Seeding tenant: {$tenant->name} ({$tenant->slug})...\n";

                $strategy = getenv('TENANCY_STRATEGY') ?: 'shared_database';
                if ($strategy === 'database_per_tenant') {
                    \Nemesis\Tenancy\TenantManager::switchConnection($tenant);
                } else {
                    \Nemesis\Tenancy\TenantManager::setCurrent($tenant);
                }

                $fqcn = "\\App\\Database\\Seeders\\{$seederClass}";
                if (!class_exists($fqcn)) {
                    echo "  [skip] Seeder class {$fqcn} not found.\n";
                    continue;
                }
                (new $fqcn())->run();
                echo "  [ok] Seeded {$tenant->slug} with {$seederClass}.\n";
            }
        } catch (\Throwable $e) {
            echo "Error: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    default:
        // v7.1.1 (Gap 12): consult the new CommandRegistry first. Plugins and
        // apps can register commands via \Nemesis\Console\CommandRegistry::getInstance()
        // and they will be picked up here before falling back to the legacy
        // CommandBus / plugin-command paths.
        $registry = \Nemesis\Console\CommandRegistry::getInstance();

        // New in v7.1.1: `php nemesis list` shows all registered commands.
        if ($command === 'list' || $command === 'commands') {
            echo "Nemesis Framework CLI — registered commands:\n\n";
            foreach ($registry->list() as $name => $description) {
                echo sprintf("  %-32s %s\n", $name, $description);
            }
            if ($registry->list() === []) {
                echo "  (no commands registered yet)\n";
            }
            echo "\nRun `php nemesis help <command>` for details on a specific command.\n";
            exit(0);
        }

        if ($command === 'help' || $command === '--help' || $command === '-h') {
            $target = $argv[2] ?? null;
            if ($target === null) {
                echo "Usage: php nemesis help <command>\n";
                exit(0);
            }
            $info = $registry->help($target);
            if ($info === null) {
                echo "No help available for '{$target}'.\n";
                exit(1);
            }
            echo "{$target} — {$info['description']}\n\n";
            echo "Usage:\n  {$info['usage']}\n";
            exit(0);
        }

        if ($registry->has($command)) {
            require_once $projectRoot . '/index.php';
            exit($registry->run($command, $argv));
        }

        // Phase 7: try CommandBus first (app/Console/Commands + plugin commands) | 2026-04-03
        $bus = \Nemesis\Reactor\CommandBus::getInstance();

        // Auto-discover app commands
        $customCommandDir = $projectRoot . '/app/Console/Commands';
        if (is_dir($customCommandDir)) {
            $bus->discoverIn($customCommandDir);
        }

        // Auto-discover plugin commands (plugins already loaded by PluginManager)
        if ($bus->has($command)) {
            require_once $projectRoot . '/index.php';
            exit($bus->dispatch($argv));
        }

        // Legacy fallback: plugin string-based commands
        $manager = \Nemesis\Core\PluginManager::getInstance();
        $manager->discover();
        $pluginCommands = \Nemesis\Core\Plugin::getCommands();
        foreach ($pluginCommands as $cmdClass) {
            $cmd = new $cmdClass();
            $sig = method_exists($cmd, 'getSignature') ? $cmd->getSignature() : ($cmd->signature ?? null);
            if ($sig === $command) {
                require_once $projectRoot . '/index.php';
                if (method_exists($cmd, 'run')) {
                    exit($cmd->run(new \Nemesis\Console\Input($argv), new \Nemesis\Console\Output()));
                }
                // Very old commands: handle($args)
                $cmd->handle(array_slice($argv, 2));
                exit(0);
            }
        }

        echo "Nemesis Framework CLI\n";
        echo "Usage:\n";
        echo "  php nemesis serve [host:port]\n";
        echo "  php nemesis make:controller Name\n";
        echo "  php nemesis make:model Name\n";
        echo "  php nemesis make:middleware Name\n";
        break;
}

function updateEnv($key, $value) {
    global $projectRoot;
    $path = $projectRoot . '/.env';
    if (!file_exists($path)) return;

    $content = file_get_contents($path);
    if (strpos($content, "{$key}=") !== false) {
        $content = preg_replace("/^{$key}=.*/m", "{$key}={$value}", $content);
    } else {
        $content .= "\n{$key}={$value}";
    }
    file_put_contents($path, $content);
}

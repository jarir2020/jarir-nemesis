            'LoginController' => <<<'PHP'
<?php
declare(strict_types=1);
namespace App\Controllers\Auth;

use Nemesis\Auth\AuthManager;
use Nemesis\Http\Request;
use Nemesis\Http\Response;

class LoginController
{
    public function login(Request $request): Response
    {
        $data   = $request->validate(['email' => 'required|email', 'password' => 'required']);
        $tokens = AuthManager::attempt($data);
        if (!$tokens) {
            return Response::json(['error' => 'Invalid credentials.'], 401);
        }
        return Response::json($tokens);
    }

    public function refresh(Request $request): Response
    {
        $refresh = $request->input('refresh_token');
        if (!$refresh) return Response::json(['error' => 'refresh_token required.'], 422);
        try {
            $payload = ['sub' => 0]; // reload from DB in production
            return Response::json(AuthManager::refresh($refresh, $payload));
        } catch (\Throwable $e) {
            return Response::json(['error' => $e->getMessage()], 401);
        }
    }

    public function logout(Request $request): Response
    {
        AuthManager::logout($request);
        return Response::json(['message' => 'Logged out successfully.']);
    }
}
PHP,
            'RegisterController' => <<<'PHP'
<?php
declare(strict_types=1);
namespace App\Controllers\Auth;

use Nemesis\Core\Database;
use Nemesis\Http\Request;
use Nemesis\Http\Response;

class RegisterController
{
    public function register(Request $request): Response
    {
        $data = $request->validate([
            'name'                  => 'required|min:2',
            'email'                 => 'required|email',
            'password'              => 'required|min:8',
            'password_confirmation' => 'required',
        ]);

        if ($data['password'] !== $data['password_confirmation']) {
            return Response::json(['error' => 'Passwords do not match.'], 422);
        }

        $exists = Database::view("SELECT id FROM users WHERE email = ? LIMIT 1", [$data['email']]);
        if ($exists) return Response::json(['error' => 'Email already registered.'], 409);

        Database::statement(
            "INSERT INTO users (name, email, password, created_at) VALUES (?, ?, ?, ?)",
            [$data['name'], $data['email'], password_hash($data['password'], PASSWORD_BCRYPT), date('Y-m-d H:i:s')]
        );

        return Response::json(['message' => 'Registration successful.'], 201);
    }
}

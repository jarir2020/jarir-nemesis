# ===================================================================
#  Nemesis — environment configuration
#  Copy to .env (done automatically on create-project) and fill in.
#  Anything commented out is optional; uncomment what you need.
# ===================================================================

# -------------------------------------------------------------------
# Application
# -------------------------------------------------------------------
APP_NAME="Nemesis App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en

# -------------------------------------------------------------------
# Database — SQLite (default, zero-config)
# -------------------------------------------------------------------
DB_DRIVER=sqlite
DB_DATABASE=database/nemesis.sqlite

# Database — MySQL (set DB_DRIVER=mysql to use)
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=nemesis
# DB_USER=root
# DB_PASS=

# Database — PostgreSQL (set DB_DRIVER=pgsql to use)
# DB_DRIVER=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=nemesis
# DB_USER=postgres
# DB_PASS=

# -------------------------------------------------------------------
# Cache  (config/cache.php — also used by jarir-ahmed/cache)
# -------------------------------------------------------------------
CACHE_DRIVER=file
CACHE_PREFIX=nemesis_
CACHE_TTL=3600
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=1

# -------------------------------------------------------------------
# Queue
# -------------------------------------------------------------------
QUEUE_DRIVER=sync
# REDIS_QUEUE=default

# -------------------------------------------------------------------
# Session
# -------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=nemesis_session
SESSION_SECURE_COOKIE=false
# Optional; defaults to the application-local storage/session directory.
# SESSION_PATH=/absolute/path/to/storage/session

# -------------------------------------------------------------------
# Mail (config/mail.php) — also used by notification-system
# -------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=hello@example.com
MAIL_FROM_NAME="Nemesis Framework"

# -------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DAYS=14

# -------------------------------------------------------------------
# Filesystem / Media (config/filesystems.php, config/media.php)
# -------------------------------------------------------------------
FILESYSTEM_DRIVER=local
# FILESYSTEM_CLOUD=s3
MEDIA_DISK=local
MEDIA_MAX_SIZE=10240
MEDIA_QUALITY=85

# AWS S3 (used by filesystems/media when a cloud disk is enabled)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=

# -------------------------------------------------------------------
# Assets / Vite (config/assets.php)
# -------------------------------------------------------------------
# ASSET_DRIVER=vite
# VITE_DEV_URL=http://localhost:5173
# VITE_HOT=false

# -------------------------------------------------------------------
# Indexed search engines (config/search.php — Meilisearch / Typesense)
# Not the same as jarir-ahmed/uncensored-search (web search) below.
# -------------------------------------------------------------------
# SEARCH_DRIVER=meilisearch
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=
# TYPESENSE_HOST=http://127.0.0.1:8108
# TYPESENSE_API_KEY=

# ===================================================================
#  First-party packages (jarir-ahmed/*) — bundled, dormant until used.
#  Resolve via app('cache') / app('llm') / app('search.web').
# ===================================================================

# --- jarir-ahmed/php-llm  ->  app('llm') ---------------------------
# Pick a default provider, then set that provider's API key.
# AI_DEFAULT_LLM=openai
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# Azure OpenAI:
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Local Ollama (no key needed):
# OLLAMA_BASE_URL=http://localhost:11434

# --- jarir-ahmed/uncensored-search  ->  app('search.web') ----------
# Set one or more; the client fails over across whichever are present.
# SERPER_API_KEY=
# TAVILY_API_KEY=
# SEARCHAPI_API_KEY=
# SCAVIO_API_KEY=
# FIRECRAWL_API_KEY=
# SCRAPINGBEE_API_KEY=

# ===================================================================
#  Optional feature configs (uncomment the block you use)
# ===================================================================

# --- E-commerce / payments (config/ecommerce.php) ------------------
# SHOP_CURRENCY=USD
# PAYMENT_DRIVER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_SANDBOX=true

# --- Social login (config/social.php) ------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT=

# --- Notifications (config/notifications.php) ----------------------
# SLACK_WEBHOOK_URL=

# --- Multi-tenancy (config/tenancy.php) ----------------------------
# TENANCY_STRATEGY=subdomain
# TENANT_IDENTIFICATION=subdomain
# TENANT_SUBDOMAIN_BASE=example.com
# TENANT_HEADER=X-Tenant
# TENANT_DB_DRIVER=mysql
# TENANT_DB_HOST=127.0.0.1
# TENANT_DB_PORT=3306
# TENANT_DB_USER=root
# TENANT_DB_PASS=
# TENANT_DB_PREFIX=tenant_

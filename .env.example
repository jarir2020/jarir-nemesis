APP_NAME="Nemesis App"
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

# -------------------------------------------------------------------
# Database — SQLite (default, zero-config)
# -------------------------------------------------------------------
DB_DRIVER=sqlite
DB_DATABASE=database/nemesis.sqlite

# -------------------------------------------------------------------
# Database — MySQL (uncomment and set DB_DRIVER=mysql to use)
# -------------------------------------------------------------------
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=nemesis
# DB_USER=root
# DB_PASS=

# -------------------------------------------------------------------
# Database — PostgreSQL (uncomment and set DB_DRIVER=pgsql to use)
# -------------------------------------------------------------------
# DB_DRIVER=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=nemesis
# DB_USER=postgres
# DB_PASS=

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=hello@example.com
MAIL_FROM_NAME="Nemesis Framework"

CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

QUEUE_DRIVER=sync

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
